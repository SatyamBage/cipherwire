# Cipherwire relay environment.
# Install as /etc/cipherwire/cipherwire.env with mode 0600 and owner root:root.
# Replace every <PLACEHOLDER> before starting the service.

CHAT_HOST=127.0.0.1
CHAT_PORT=55555
CHAT_STATE_DIR=/var/lib/cipherwire

# Browser origins allowed to open a WebSocket. CLI clients send no Origin.
# Relay-hosted web client:
CHAT_ALLOWED_ORIGINS=https://<DOMAIN>
# Separate static hosting example:
# CHAT_ALLOWED_ORIGINS=https://<STATIC_HOST>

CHAT_MAX_CONNECTIONS=256
CHAT_MAX_IDENTITIES=10000

# TLS is terminated by Caddy in the recommended deployment. Leave these unset.
# CHAT_TLS_CERT=/etc/cipherwire/fullchain.pem
# CHAT_TLS_KEY=/etc/cipherwire/privkey.pem
